{
  "_comment": "Merge the two objects below into the array at hooks.PreToolUse in ~/.claude/settings.json. Preserve any existing entries. The install.sh script does this automatically and idempotently.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/policy-freeze.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/destructive-guard.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
