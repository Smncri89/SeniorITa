Clear-Host

# Header
Write-Host "==================================================" -ForegroundColor Cyan
Write-Host "           REPORT METRICHE DI SISTEMA            " -ForegroundColor Cyan
Write-Host "==================================================" -ForegroundColor Cyan
Write-Host ""

# 1. DISCHI RIGIDI
Write-Host "[1] STATO DISCHI RIGIDI" -ForegroundColor Yellow
$disks = Get-CimInstance -ClassName Win32_LogicalDisk -Filter "DriveType=3" | Select-Object DeviceID, VolumeName,
    @{Name="Dimensione (GB)"; Expression={[math]::Round($_.Size / 1GB, 2)}},
    @{Name="Spazio Libero (GB)"; Expression={[math]::Round($_.FreeSpace / 1GB, 2)}},
    @{Name="Spazio Usato (GB)"; Expression={[math]::Round(($_.Size - $_.FreeSpace) / 1GB, 2)}},
    @{Name="% Libera"; Expression={[math]::Round(($_.FreeSpace / $_.Size) * 100, 2)}}

$disks | Format-Table -AutoSize | Out-String | Write-Host

# 2. USO CPU E RAM
Write-Host "[2] UTILIZZO RISORSE (CPU E RAM)" -ForegroundColor Yellow

$os = Get-CimInstance -ClassName Win32_OperatingSystem
$totalRamGB = [math]::Round($os.TotalVisibleMemorySize / 1MB, 2)
$freeRamGB = [math]::Round($os.FreePhysicalMemory / 1MB, 2)
$usedRamGB = [math]::Round($totalRamGB - $freeRamGB, 2)
$ramUsagePercent = [math]::Round(($usedRamGB / $totalRamGB) * 100, 2)

$cpuLoad = (Get-CimInstance -ClassName Win32_Processor | Measure-Object -Property LoadPercentage -Average).Average

$resourceTable = [PSCustomObject]@{
    "Uso CPU (%)"       = "$cpuLoad %"
    "RAM Totale (GB)"   = $totalRamGB
    "RAM Usata (GB)"    = $usedRamGB
    "RAM Libera (GB)"   = $freeRamGB
    "Uso RAM (%)"       = "$ramUsagePercent %"
}

$resourceTable | Format-Table -AutoSize | Out-String | Write-Host

# 3. TOP 5 PROCESSI PER MEMORIA
Write-Host "[3] TOP 5 PROCESSI PER CONSUMO DI MEMORIA" -ForegroundColor Yellow

$topProcesses = Get-Process | Sort-Object -Property WorkingSet64 -Descending | Select-Object -First 5 | Select-Object Id,
    @{Name="Nome Processo"; Expression={$_.ProcessName}},
    @{Name="Memoria (MB)"; Expression={[math]::Round($_.WorkingSet64 / 1MB, 2)}},
    @{Name="Memoria (GB)"; Expression={[math]::Round($_.WorkingSet64 / 1GB, 2)}}

$topProcesses | Format-Table -AutoSize | Out-String | Write-Host

Write-Host "==================================================" -ForegroundColor Cyan
